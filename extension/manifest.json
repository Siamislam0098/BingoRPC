{
  "manifest_version": 3,
  "name": "BingoRPC",
  "version": "0.2.0",
  "description": "Shows what you are watching on streaming sites as your Discord status.",
  "key": "",
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BingoRPC"
  }
}
