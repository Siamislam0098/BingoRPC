{
  "name": "bingorpc-native-host",
  "version": "0.3.0",
  "description": "Native helper that sets the Discord status for BingoRPC",
  "main": "host.js",
  "private": true,
  "scripts": {
    "start": "node host.js",
    "bundle": "esbuild host.js --bundle --platform=node --target=node22 --external:bufferutil --external:utf-8-validate --outfile=dist/host.cjs",
    "sea": "node build-exe.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "postject": "^1.0.0-alpha.6"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.0"
  }
}
